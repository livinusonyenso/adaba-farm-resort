# Server Configuration
PORT=3001
NODE_ENV=development

# Adaba Farm Resort SMTP Configuration
# Localhost can't connect to mail.kazfieldisl.com:465 (port blocked)
# Emails will be MOCKED in development mode (see email.service.js)
SMTP_HOST=mail.kazfieldisl.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=false
EMAIL_USER=adabafarmresort@kazfieldisl.com
EMAIL_PASS=*5@_k($T)&.E
SUBSCRIPTION_EMAIL=adabafarmresortsubscription@kazfieldisl.com


# Note: These exact settings work in production (Render) where port 465 is not blocked

# Email Recipients
OWNER_EMAIL=adabafarmresort@kazfieldisl.com
COMPANY_EMAIL=adabafarmresort@kazfieldisl.com

# Frontend URL
FRONTEND_URL=https://adaba-farm-resort.onrender.com/

# Common SMTP Settings Reference:
# Gmail: smtp.gmail.com:587 (secure=false) or smtp.gmail.com:465 (secure=true)
# Outlook: smtp-mail.outlook.com:587 (secure=false)
# Yahoo: smtp.mail.yahoo.com:587 (secure=false)
# Custom: your-smtp-server.com:587 (secure=false)
